    def evaluate(self, resume_text):
        """评估单份简历"""
        resume_lower = resume_text.lower()
        
        # 1. 评估硬性条件
        hard_results = {}
        hard_score = 0
        hard_max = 0
        mandatory_missing = []
        
        for req_name, req_config in self.hard_requirements.items():
            weight = req_config["weight"]
            hard_max += weight
            
            # 检查匹配
            matched_keywords = []
            for keyword in req_config["keywords"]:
                if keyword in resume_lower:
                    matched_keywords.append(keyword)
            
            is_matched = len(matched_keywords) > 0
            item_score = weight if is_matched else 0
            
            if is_matched:
                hard_score += item_score
            
            hard_results[req_name] = {
                "matched": is_matched,
                "score": item_score,
                "keywords": matched_keywords[:3],  # 只保留前3个
                "mandatory": req_config.get("mandatory", False)
            }
            
            if req_config.get("mandatory", False) and not is_matched:
                mandatory_missing.append(req_name)
        
        hard_final = (hard_score / hard_max * 100) if hard_max > 0 else 0
        
        # 2. 评估核心能力
        core_results = {}
        core_score = 0
        core_max = 0
        
        for comp_name, comp_config in self.core_competencies.items():
            weight = comp_config["weight"]
            core_max += weight
            
            # 计算匹配强度
            match_count = 0
            matched_keywords = []
            for keyword in comp_config["keywords"]:
                if keyword in resume_lower:
                    match_count += 1
                    matched_keywords.append(keyword)
            
            # 匹配强度：0-3个关键词 -> 0-100%分数
            match_strength = min(match_count / 3, 1.0)  # 最多匹配3个就满分
            item_score = weight * match_strength
            core_score += item_score
            
            core_results[comp_name] = {
                "match_strength": match_strength,
                "score": item_score,
                "keywords": matched_keywords[:3],
                "match_count": match_count
            }
        
        core_final = (core_score / core_max * 100) if core_max > 0 else 0
        
        # 3. 评估加分项
        bonus_results = {}
        bonus_score = 0
        bonus_max = 0
        
        for bonus_name, bonus_config in self.bonus_items.items():
            weight = bonus_config["weight"]
            bonus_max += weight
            
            matched_keywords = []
            for keyword in bonus_config["keywords"]:
                if keyword in resume_lower:
                    matched_keywords.append(keyword)
            
            is_matched = len(matched_keywords) > 0
            item_score = weight if is_matched else 0
            bonus_score += item_score
            
            bonus_results[bonus_name] = {
                "matched": is_matched,
                "score": item_score,
                "keywords": matched_keywords[:2]
            }
        
        bonus_final = (bonus_score / bonus_max * 100) if bonus_max > 0 else 0
        
        # 4. 计算总分
        total_score = (
            hard_final * self.weights["hard"] +
            core_final * self.weights["core"] +
            bonus_final * self.weights["bonus"]
        )
        
        # 5. 严重惩罚：缺失必须项
        if mandatory_missing:
            total_score *= 0.3  # 缺失必须项，得分降至30%
        
        # 6. 匹配度质量分析
        quality_indicators = {
            "hard_match_rate": len([r for r in hard_results.values() if r["matched"]]) / len(hard_results),
            "core_avg_strength": sum(r["match_strength"] for r in core_results.values()) / len(core_results) if core_results else 0,
            "bonus_count": len([r for r in bonus_results.values() if r["matched"]]),
            "total_keywords": sum(len(r["keywords"]) for r in hard_results.values()) +
                             sum(len(r["keywords"]) for r in core_results.values()) +
                             sum(len(r["keywords"]) for r in bonus_results.values())
        }
        
        return {
            "total_score": total_score,
            "breakdown": {
                "hard": {"score": hard_final, "results": hard_results},
                "core": {"score": core_final, "results": core_results},
                "bonus": {"score": bonus_final, "results": bonus_results}
            },
            "quality": quality_indicators,
            "mandatory_missing": mandatory_missing,
            "text_length": len(resume_text)
        }
    
    def get_rating(self, score):
        """根据分数获取评级"""
        if score >= 85:
            return "🟢 强烈推荐", "核心能力突出，高度匹配岗位要求"
        elif score >= 70:
            return "🟡 推荐面试", "符合基本要求，具备培养潜力"
        elif score >= 60:
            return "🟠 可考虑", "部分条件符合，但有明显短板"
        else:
            return "🔴 暂不考虑", "不符合基本要求"
    
    def generate_insights(self, evaluation_result):
        """生成深度洞察"""
        insights = []
        breakdown = evaluation_result["breakdown"]
        
        # 硬性条件分析
        hard_matched = [name for name, data in breakdown["hard"]["results"].items() if data["matched"]]
        hard_missing = [name for name, data in breakdown["hard"]["results"].items() if not data["matched"]]
        
        if hard_matched:
            insights.append(f"✅ 硬性条件满足: {len(hard_matched)}/{len(self.hard_requirements)}项")
            if "硕士学历" in hard_matched:
                insights.append("  • 具备硕士学历，符合基本门槛")
            if "教育行业经验" in hard_matched:
                insights.append("  • 有教育行业经验，可快速上手")
        
        if hard_missing:
            insights.append(f"⚠️  缺失硬性条件: {', '.join(hard_missing)}")
        
        # 核心能力分析
        top_core = sorted(
            [(name, data) for name, data in breakdown["core"]["results"].items()],
            key=lambda x: x[1]["match_strength"],
            reverse=True
        )[:3]
        
        if top_core:
            insights.append("🎯 核心能力优势:")
            for name, data in top_core:
                if data["match_strength"] >= 0.5:
                    insights.append(f"  • {name}: {data['match_strength']:.1%}")
        
        # 加分项分析
        bonus_matched = [name for name, data in breakdown["bonus"]["results"].items() if data["matched"]]
        if bonus_matched:
            insights.append("✨ 加分项优势:")
            for bonus in bonus_matched:
                if bonus == "考研经历":
                    insights.append("  • 有考研经历，易于理解学员痛点")
                elif bonus == "谈判技巧":
                    insights.append("  • 具备谈判技巧，利于提高转化率")
        
        return insights

# ================ 第三部分：批量处理器 ================
class ResumeBatchProcessor:
    """简历批量处理器"""
    
    def __init__(self, folder_path="resumes"):
        self.folder_path = folder_path
        self.evaluator = EducationalConsultantEvaluator()
        self.extractor = TextExtractor()
        self.results = []
        
        # 创建文件夹（如果不存在）
        os.makedirs(folder_path, exist_ok=True)
    
    def scan_resumes(self):
        """扫描简历文件夹"""
        print(f"\n🔍 扫描文件夹: {self.folder_path}")
        
        if not os.path.exists(self.folder_path):
            print(f"❌ 文件夹不存在: {self.folder_path}")
            print(f"💡 请创建文件夹: mkdir {self.folder_path}")
            return []
        
        # 支持的文件格式
        supported_formats = ['.txt']
        if PDF_SUPPORT:
            supported_formats.append('.pdf')
        if DOCX_SUPPORT:
            supported_formats.extend(['.docx', '.doc'])
        
        # 收集文件
        resume_files = []
        for filename in os.listdir(self.folder_path):
            filepath = os.path.join(self.folder_path, filename)
            
            if os.path.isfile(filepath):
                ext = os.path.splitext(filename)[1].lower()
                if ext in supported_formats:
                    resume_files.append({
                        "filename": filename,
                        "filepath": filepath,
                        "extension": ext
                    })
        
        print(f"📁 找到 {len(resume_files)} 份简历文件")
        return resume_files
    
    def process_single(self, file_info, show_details=False):
        """处理单份简历"""
        print(f"\n{'='*60}")
        print(f"📄 处理: {file_info['filename']}")
        print(f"{'='*60}")
        
        # 1. 提取文本
        print("🔧 提取文本内容...")
        resume_text = self.extractor.extract(file_info['filepath'])
        
        if not resume_text or len(resume_text.strip()) < 50:
            print("❌ 提取失败或内容过短，跳过")
            return None
        
        print(f"📊 文本长度: {len(resume_text)} 字符")
        
        # 2. AI评估
        print("🤖 AI评估中...")
        evaluation = self.evaluator.evaluate(resume_text)
        
        # 3. 获取评级
        score = evaluation["total_score"]
        rating, reason = self.evaluator.get_rating(score)
        
        # 4. 显示结果
        print(f"\n🎯 匹配度: {score:.1f}/100")
        print(f"🏆 评级: {rating}")
        print(f"📝 理由: {reason}")
        
        if show_details:
            # 显示详细匹配
            print("\n📋 详细匹配:")
            for category in ["hard", "core", "bonus"]:
                category_data = evaluation["breakdown"][category]
                print(f"\n  {category.upper()} 维度 ({category_data['score']:.1f}分):")
                for item_name, item_data in category_data["results"].items():
                    if category == "hard":
                        status = "✅" if item_data["matched"] else "❌"
                        print(f"    {status} {item_name}")
                    elif category == "core":
                        strength = item_data["match_strength"]
                        bar = "█" * int(strength * 10) + "░" * (10 - int(strength * 10))
                        print(f"    {bar} {strength:.1%} {item_name}")
                    elif category == "bonus" and item_data["matched"]:
                        print(f"    ✅ {item_name}")
        
        # 5. 显示关键洞察
        insights = self.evaluator.generate_insights(evaluation)
        if insights:
            print("\n💡 关键洞察:")
            for insight in insights[:5]:  # 只显示前5条
                print(f"  {insight}")
        
        if evaluation["mandatory_missing"]:
            print(f"\n⚠️  严重警告: 缺失必须项 {evaluation['mandatory_missing']}")
        
        # 6. 返回结果
        result = {
            "filename": file_info["filename"],
            "filepath": file_info["filepath"],
            "score": score,
            "rating": rating,
            "reason": reason,
            "evaluation": evaluation,
            "timestamp": datetime.now().isoformat()
        }
        
        return result
    
    def process_all(self, max_files=None, show_details=False):
        """处理所有简历"""
        # 扫描文件
        resume_files = self.scan_resumes()
        
        if not resume_files:
            print("❌ 没有找到支持的简历文件")
            print("💡 支持格式: .txt" + 
                  (" + .pdf" if PDF_SUPPORT else "") + 
                  (" + .docx" if DOCX_SUPPORT else ""))
            return []
        
        if max_files:
            resume_files = resume_files[:max_files]
            print(f"\n⏱️  限制处理前 {max_files} 份简历")
        
        # 批量处理
        print(f"\n🚀 开始批量处理 {len(resume_files)} 份简历...")
        self.results = []
        
        for i, file_info in enumerate(resume_files, 1):
            print(f"\n📦 进度: [{i}/{len(resume_files)}]")
            
            result = self.process_single(file_info, show_details)
            if result:
                self.results.append(result)
        
        print(f"\n✅ 处理完成: {len(self.results)}/{len(resume_files)} 份简历有效")
        return self.results
    
