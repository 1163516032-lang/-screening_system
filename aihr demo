import os
import re
import json
import time
import requests
import pdfplumber
from typing import Dict, List, Any

# ============ 配置 ============
BASE_DIR = os.path.dirname(__file__)
RESUME_DIR = os.path.join(BASE_DIR, "resumes")
OLLAMA_API = "http://127.0.0.1:11434/api/generate"   # 使用127.0.0.1避免localhost解析问题
MODEL_NAME = "qwen3:8b"
MAX_ITERATIONS = 5   # 最大循环次数，防止死循环

# 确保文件夹存在
if not os.path.exists(RESUME_DIR):
    os.makedirs(RESUME_DIR)

# ============ 工具定义 ============
# 每个工具是一个函数，并且有对应的 schema 描述

TOOLS = [
    {
        "name": "list_resumes",
        "description": "列出 resumes 文件夹中的所有 PDF 简历文件名称",
        "parameters": {}   # 无参数
    },
    {
        "name": "read_resume",
        "description": "读取指定简历的文本内容（最多2000字符）",
        "parameters": {
            "filename": "简历文件名（必须包含 .pdf）"
        }
    },
    {
        "name": "evaluate_resume",
        "description": "根据给定的岗位要求，评估一份简历并给出评分（0-100）和简短评语",
        "parameters": {
            "filename": "简历文件名",
            "job_description": "岗位要求描述"
        }
    },
    {
        "name": "finish",
        "description": "任务完成，返回最终答案给用户",
        "parameters": {
            "final_answer": "最终的总结性回复"
        }
    }
]

def tool_list_resumes() -> str:
    files = [f for f in os.listdir(RESUME_DIR) if f.lower().endswith('.pdf')]
    if not files:
        return "📁 没有找到任何 PDF 简历。"
    return "找到以下简历:\n" + "\n".join(f"  - {f}" for f in files)

def tool_read_resume(filename: str) -> str:
    path = os.path.join(RESUME_DIR, filename)
    if not os.path.exists(path):
        return f"❌ 文件 {filename} 不存在"
    text = ""
    try:
        with pdfplumber.open(path) as pdf:
            for page in pdf.pages:
                txt = page.extract_text()
                if txt:
                    text += txt + "\n"
                    if len(text) > 2000:
                        break
        return text.strip() if text else "⚠️ 未能提取到任何文本"
    except Exception as e:
        return f"❌ 读取失败: {e}"

def tool_evaluate_resume(filename: str, job_description: str) -> str:
    # 先读取简历
    resume_text = tool_read_resume(filename)
    if resume_text.startswith("❌") or resume_text.startswith("⚠️"):
        return resume_text
    
    # 构建提示词
    prompt = f"""你是一位资深的招聘专家。请根据以下岗位要求，对候选人进行综合评估。

岗位要求: {job_description}

简历内容（摘要）:
{resume_text[:1500]}

请严格按照以下格式输出（不要有多余内容）:
评分: [0-100的整数]
评语: [2-3句话，概括候选人的匹配度和建议]
"""
    # 调用LLM
    response = call_llm(prompt, temperature=0.3)
    if response.startswith("[错误]"):
        return response
    
    # 提取评分和评语
    score_match = re.search(r'评分[:：]\s*(\d+)', response)
    score = int(score_match.group(1)) if score_match else "未提供"
    comment_match = re.search(r'评语[:：]\s*(.+?)(?=\n|$)', response, re.DOTALL)
    comment = comment_match.group(1).strip() if comment_match else "评语提取失败"
    
    return f"📊 {filename}\n  评分: {score}\n  评语: {comment}"

def call_llm(prompt: str, temperature: float = 0.3) -> str:
    """调用 Ollama API"""
    payload = {
        "model": MODEL_NAME,
        "prompt": prompt,
        "stream": False,
        "options": {"temperature": temperature}
    }
    try:
        resp = requests.post(OLLAMA_API, json=payload, timeout=120)
        if resp.status_code == 200:
            return resp.json().get("response", "")
        return f"[错误] API返回状态码 {resp.status_code}"
    except requests.exceptions.ConnectionError:
        return "[错误] 无法连接到 Ollama，请确认 Ollama 正在运行"
    except requests.exceptions.Timeout:
        return "[错误] 请求超时"
    except Exception as e:
        return f"[错误] {e}"

def execute_tool(action: Dict) -> str:
    """根据 action 字典执行对应的工具"""
    tool_name = action.get("tool")
    params = action.get("params", {})
    
    if tool_name == "list_resumes":
        return tool_list_resumes()
    elif tool_name == "read_resume":
        return tool_read_resume(params.get("filename", ""))
    elif tool_name == "evaluate_resume":
        return tool_evaluate_resume(params.get("filename", ""), params.get("job_description", ""))
    elif tool_name == "finish":
        return params.get("final_answer", "任务已完成")
    else:
        return f"❌ 未知工具: {tool_name}"

# ============ Agent 核心（ReAct循环） ============

def agent_react(user_query: str) -> str:
    """ReAct 循环主函数"""
    print(f"\n👤 用户指令: {user_query}")
    print("=" * 60)
    
    # 系统提示词：告诉 Agent 可用的工具和输出格式
    sys_prompt = f"""你是一个智能HR助手，可以自主使用工具来完成用户的任务。

可用的工具如下（每个工具以JSON格式调用）：
{json.dumps(TOOLS, ensure_ascii=False, indent=2)}

用户指令: {user_query}

你的工作方式：
1. 每一步，你需要决定下一步做什么。
2. 输出必须是一个JSON对象，包含 "thought"（思考）和 "action"（行动）两个字段。
3. "action" 必须包含 "tool"（工具名）和 "params"（参数对象）。
4. 如果任务完成，调用工具 "finish"，参数 "final_answer" 为最终回复。
5. 不要输出任何多余内容，只输出JSON。

示例:
{{"thought": "用户要求筛选简历，我先列出所有简历", "action": {{"tool": "list_resumes", "params": {{}}}}}}
{{"thought": "现在我需要评估张三的简历", "action": {{"tool": "evaluate_resume", "params": {{"filename": "张三.pdf", "job_description": "需要Python和数据分析"}}}}}}
{{"thought": "所有简历评估完毕，生成最终报告", "action": {{"tool": "finish", "params": {{"final_answer": "经过评估，推荐李四和王五"}}}}}}
"""
    
    # 历史记录，用于提供上下文
    history = sys_prompt
    iteration = 0
    final_answer = None
    
    while iteration < MAX_ITERATIONS:
        iteration += 1
        print(f"\n🔄 第 {iteration} 轮思考...")
        
        # 调用 LLM 获取下一步行动
        llm_input = f"{history}\n\n现在，输出你的下一步行动（JSON格式）："
        response = call_llm(llm_input, temperature=0.2)
        
        if response.startswith("[错误]"):
            return f"❌ Agent 出错: {response}"
        
        # 尝试解析 JSON
        try:
            # 有时模型会输出 markdown 代码块，尝试提取
            json_match = re.search(r'\{.*\}', response, re.DOTALL)
            if json_match:
                response = json_match.group(0)
            action_data = json.loads(response)
        except json.JSONDecodeError as e:
            # 如果解析失败，记录原始响应并让模型重试或退出
            print(f"⚠️ JSON 解析失败，响应内容: {response[:200]}...")
            history += f"\n\n你的输出不是有效的JSON，请修正。错误: {e}"
            continue
        
        thought = action_data.get("thought", "无思考")
        action = action_data.get("action", {})
        tool_name = action.get("tool")
        params = action.get("params", {})
        
        print(f"💭 思考: {thought}")
        print(f"🔧 行动: 调用 {tool_name}，参数: {params}")
        
        # 执行工具
        observation = execute_tool(action)
        print(f"📊 观察: {observation[:150]}..." if len(observation) > 150 else f"📊 观察: {observation}")
        
        # 如果调用了 finish，结束循环
        if tool_name == "finish":
            final_answer = observation
            break
        
        # 将本次交互添加到历史中
        history += f"\n\n用户指令: {user_query}\n你执行了工具 {tool_name}，结果是: {observation}"
        
        # 检查是否已经收集了足够信息（简化：如果已经评估了所有简历，自动结束）
        if tool_name == "evaluate_resume" and "评估完成" in observation:
            # 可以添加逻辑判断是否所有简历已评估，但这里交给模型自己决定
            pass
    
    # 如果循环结束还没有 finish，生成一个汇总
    if final_answer is None:
        # 让模型总结当前状态
        prompt = f"{history}\n\n任务似乎未明确结束，请根据已有的观察结果，给出一个最终答案。"
        final_answer = call_llm(prompt, temperature=0.2)
        if final_answer.startswith("[错误]"):
            final_answer = "Agent 运行超时或出错，请重试。"
    
    return final_answer

# ============ 交互入口 ============

def main():
    print("=" * 60)
    print("  🤖  ReAct 简历筛选 Agent")
    print("=" * 60)
    print("\n这个 Agent 会自主思考、调用工具来帮你筛选简历。")
    print("它会自动列出简历、读取内容、根据你的要求评估并给出推荐。")
    print("你只需输入岗位要求，例如：")
    print("  '筛选数据分析师，需要Python、SQL、Tableau'")
    print("或直接输入 '帮我看看简历'")
    print("输入 'exit' 退出\n")
    
    # 检查 Ollama
    try:
        test = requests.post(OLLAMA_API, json={"model": MODEL_NAME, "prompt": "ping", "stream": False}, timeout=5)
        if test.status_code != 200:
            print("⚠️ Ollama 未正常运行，请检查服务是否启动。")
            return
        print("✅ Ollama 连接正常\n")
    except:
        print("⚠️ 无法连接到 Ollama，请确认 Ollama 正在运行（右下角羊驼图标）。")
        return
    
    while True:
        user_input = input("👤 你: ").strip()
        if not user_input:
            continue
        if user_input.lower() in ["exit", "quit", "q"]:
            print("👋 再见！")
            break
        
        # 运行 Agent
        result = agent_react(user_input)
        print("\n" + "=" * 60)
        print("🤖 最终答案:")
        print(result)
        print("=" * 60 + "\n")

if __name__ == "__main__":
    main()
