        for req in ["硕士学历", "销售意识", "教育行业经验"]:
            count = len([r for r in sorted_results 
                        if r["evaluation"]["breakdown"]["hard"]["results"].get(req, {}).get("matched", False)])
            percentage = (count / len(sorted_results)) * 100
            report_lines.append(f"{req}: {count}人 ({percentage:.1f}%)")
        
        # 加分项统计
        report_lines.append(f"\n✨ 加分项统计:")
        for bonus in ["考研经历", "谈判技巧", "抗压能力"]:
            count = len([r for r in sorted_results 
                        if r["evaluation"]["breakdown"]["bonus"]["results"].get(bonus, {}).get("matched", False)])
            if count > 0:
                percentage = (count / len(sorted_results)) * 100
                report_lines.append(f"  {bonus}: {count}人 ({percentage:.1f}%)")
        
        # 招聘建议
        report_lines.extend([
            "\n" + "=" * 70,
            "💡 招聘建议",
            "=" * 70
        ])
        
        excellent_count = len([r for r in sorted_results if r["score"] >= 85])
        good_count = len([r for r in sorted_results if 70 <= r["score"] < 85])
        
        if excellent_count >= 3:
            report_lines.append("✅ 候选人质量优秀，建议:")
            report_lines.append("  1. 优先面试Top 3-5名候选人")
            report_lines.append("  2. 可适当提高筛选标准")
            report_lines.append("  3. 重点关注匹配度≥85的候选人")
        elif excellent_count >= 1 or good_count >= 3:
            report_lines.append("🟡 候选人质量良好，建议:")
            report_lines.append("  1. 面试匹配度≥70的候选人")
            report_lines.append("  2. 重点考察硬性条件匹配情况")
            report_lines.append("  3. 验证加分项的实际能力")
        else:
            report_lines.append("🔴 候选人质量一般，建议:")
            report_lines.append("  1. 扩大招聘渠道获取更多简历")
            report_lines.append("  2. 重新审视岗位要求的合理性")
            report_lines.append("  3. 考虑放宽部分非核心要求")
        
        report_lines.append("\n" + "=" * 70)
        
        return "\n".join(report_lines)
    
    def save_results(self, output_dir="output"):
        """保存结果到文件"""
        os.makedirs(output_dir, exist_ok=True)
        
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        
        # 1. 保存详细结果（JSON）
        json_file = os.path.join(output_dir, f"results_{timestamp}.json")
        output_data = {
            "timestamp": datetime.now().isoformat(),
            "total_processed": len(self.results),
            "results": self.results
        }
        
        with open(json_file, 'w', encoding='utf-8') as f:
            json.dump(output_data, f, ensure_ascii=False, indent=2)
        
        # 2. 保存报告（TXT）
        report_file = os.path.join(output_dir, f"report_{timestamp}.txt")
        report = self.generate_report()
        
        with open(report_file, 'w', encoding='utf-8') as f:
            f.write(report)
        
        # 3. 保存Top候选人简表（CSV）
        csv_file = os.path.join(output_dir, f"top_candidates_{timestamp}.csv")
        sorted_results = sorted(self.results, key=lambda x: x["score"], reverse=True)
        
        csv_lines = ["文件名,匹配度,评级,硬性条件,加分项,缺失项"]
        for result in sorted_results[:10]:  # Top 10
            filename = result["filename"]
            score = result["score"]
            rating = result["rating"].split(" ")[1]  # 只取中文部分
            
            # 硬性条件
            hard_matched = [name for name, data in result["evaluation"]["breakdown"]["hard"]["results"].items() 
                          if data["matched"]]
            hard_str = "|".join(hard_matched[:3])
            
            # 加分项
            bonus_matched = [name for name, data in result["evaluation"]["breakdown"]["bonus"]["results"].items() 
                           if data["matched"]]
            bonus_str = "|".join(bonus_matched)
            
            # 缺失项
            missing = result["evaluation"]["mandatory_missing"]
            missing_str = "|".join(missing) if missing else "无"
            
            csv_lines.append(f'{filename},{score:.1f},{rating},"{hard_str}","{bonus_str}","{missing_str}"')
        
        with open(csv_file, 'w', encoding='utf-8') as f:
            f.write("\n".join(csv_lines))
        
        print(f"\n💾 结果已保存到 {output_dir}/ 文件夹:")
        print(f"  📄 详细结果: {json_file}")
        print(f"  📊 筛选报告: {report_file}")
        print(f"  📋 Top候选人: {csv_file}")
        
        return json_file, report_file, csv_file

